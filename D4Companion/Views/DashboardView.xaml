<UserControl x:Class="D4Companion.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:D4Companion.Views"
             xmlns:converters="clr-namespace:D4Companion.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:loc="clr-namespace:D4Companion.Localization;assembly=D4Companion.Localization"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:system="clr-namespace:System;assembly=netstandard" 
             xmlns:wpftoolkit="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:viewmodels="clr-namespace:D4Companion.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:DashboardViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:ThumbnailReferenceEqualsMultiConverter x:Key="ThumbnailRefEqualsMulti" />
        <system:Boolean x:Key="True">True</system:Boolean>
        <system:Boolean x:Key="False">False</system:Boolean>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Grid.Row="0"  Orientation="Vertical">
            <StackPanel Orientation="Horizontal" Margin="0 0 0 1">
                <Grid Margin="0 0 1 0">
                    <TextBox Name="TextBoxThumbnail" Grid.Row="0" Grid.Column="0" Width="160" Text="{Binding Path=ThumbnailName,UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" GotFocus="TextBoxThumbnail_GotFocus" LostFocus="TextBoxThumbnail_LostFocus" />
                    <TextBlock Name="TextBoxThumbnailWatermark" Grid.Row="0" Grid.Column="0" Text="{loc:LocExtension rsCapEnterName}" Width="125" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="5 0 0 0" IsHitTestVisible="False" Foreground="DimGray" FontStyle="Italic"/>
                </Grid>
                <Button Command="{Binding AddThumbnailCommand}" ToolTip="{loc:LocExtension rsTooltipAddThumbnail}">
                    <iconPacks:PackIconMaterial Kind="Plus" />
                </Button>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Column="0" Grid.Row="1">
            <Border BorderThickness="1" BorderBrush="#333333">
                <ItemsControl ItemsSource="{Binding Thumbnails}" >
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Grid>
                                <Border CornerRadius="3" Margin="3" Background="#333333">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="1"/>
                                    </Border.Effect>
                                </Border>
                                <Border CornerRadius="3" Margin="3" Background="#333333">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Margin="2 2 2 2" TextTrimming="CharacterEllipsis" FontSize="15"
                                                   Text="{Binding Path=Name}">
                                            <TextBlock.InputBindings>
                                                <MouseBinding Command="{Binding Path=DataContext.SetSelectedThumbnailEditCommand, RelativeSource={RelativeSource AncestorType={x:Type local:DashboardView}}}" CommandParameter="{Binding}" MouseAction="LeftDoubleClick" />
                                                <MouseBinding Command="{Binding Path=DataContext.SetSelectedThumbnailEditToggleCommand, RelativeSource={RelativeSource AncestorType={x:Type local:DashboardView}}}" CommandParameter="{Binding}" MouseAction="RightClick" />
                                            </TextBlock.InputBindings>

                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Background" Value="#666666" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Style.Triggers>

                                                        <DataTrigger Value="True" Binding="{Binding Path=IsEnabled}">
                                                            <Setter Property="Background" Value="#333333" />
                                                        </DataTrigger>

                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource ThumbnailRefEqualsMulti}">
                                                                    <Binding />
                                                                    <Binding Path="DataContext.SelectedThumbnailEdit"
                                                                             RelativeSource="{RelativeSource AncestorType={x:Type local:DashboardView}}" />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>

                                                            <Setter Property="Foreground" Value="Orange" />
                                                        </DataTrigger>

                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Button Grid.Column="1" Width="20" BorderThickness="0" Padding="0 5 0 5"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                                Command="{Binding Path=DataContext.RemoveThumbnailCommand, RelativeSource={RelativeSource AncestorType={x:Type local:DashboardView}}}" CommandParameter="{Binding}">
                                            <iconPacks:PackIconMaterial Width="10" Height="10" Kind="CloseThick" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Border>
        </ScrollViewer>

        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding ToggleDashboardOverlayCommand}" ToolTip="{loc:LocExtension rsTooltipToggleDashboardOverlayOn}">
                    <iconPacks:PackIconMaterial Kind="Power" />
                </Button>
                <Label Content="{loc:LocExtension rsCapSource}" MinWidth="75"/>
                <Label Content="X:"/>
                <mah:NumericUpDown Width="85"
                                   Minimum="0"
                                   Maximum="9999"
                                   Interval="1"
                                   IsEnabled="{Binding IsSelectedThumbnailSet}"
                                   Value="{Binding SelectedThumbnailEdit.SourcePositionX, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="Y:"/>
                <mah:NumericUpDown Width="85"
                                   Minimum="0"
                                   Maximum="9999"
                                   Interval="1"
                                   IsEnabled="{Binding IsSelectedThumbnailSet}"
                                   Value="{Binding SelectedThumbnailEdit.SourcePositionY, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="W:"/>
                <mah:NumericUpDown Width="85"
                                   Minimum="5"
                                   Maximum="9999"
                                   Interval="1"
                                   IsEnabled="{Binding IsSelectedThumbnailSet}"
                                   Value="{Binding SelectedThumbnailEdit.SourceWidth, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="H:"/>
                <mah:NumericUpDown Width="85"
                                   Minimum="5"
                                   Maximum="9999"
                                   Interval="1"
                                   IsEnabled="{Binding IsSelectedThumbnailSet}"
                                   Value="{Binding SelectedThumbnailEdit.SourceHeight, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding UpdateScreenshotCommand}" ToolTip="{loc:LocExtension rsTooltipUpdateScreenshot}">
                    <iconPacks:PackIconMaterial Kind="Refresh" />
                </Button>
                <Label Content="{loc:LocExtension rsCapDestination}" MinWidth="75"/>
                <Label Content="X:"/>
                <mah:NumericUpDown Width="85"
                                   Minimum="0"
                                   Maximum="9999"
                                   Interval="1"
                                   IsEnabled="{Binding IsSelectedThumbnailSet}"
                                   Value="{Binding SelectedThumbnailEdit.DestinationPositionX, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="Y:"/>
                <mah:NumericUpDown Width="85"
                                   Minimum="0"
                                   Maximum="9999"
                                   Interval="1"
                                   IsEnabled="{Binding IsSelectedThumbnailSet}"
                                   Value="{Binding SelectedThumbnailEdit.DestinationPositionY, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="W:"/>
                <mah:NumericUpDown Width="85"
                                   Minimum="5"
                                   Maximum="9999"
                                   Interval="1"
                                   IsEnabled="{Binding IsSelectedThumbnailSet}"
                                   Value="{Binding SelectedThumbnailEdit.DestinationWidth, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="H:"/>
                <mah:NumericUpDown Width="85"
                                   Minimum="5"
                                   Maximum="9999"
                                   Interval="1"
                                   IsEnabled="{Binding IsSelectedThumbnailSet}"
                                   Value="{Binding SelectedThumbnailEdit.DestinationHeight, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </StackPanel>

        <Image Grid.Column="1" Grid.Row="1" Source="{Binding ScreenshotImage}" x:Name="ScreenshotImage"
               MouseLeftButtonDown="ScreenshotImage_MouseLeftButtonDown"/>

    </Grid>
</UserControl>
